# ═══ P31 BUFFER — Environment Configuration ═══
# Copy to .env and set your values. All are optional.
# The app works with zero config (offline mode).

# Buffer API (FastAPI backend)
VITE_API_URL=http://localhost:8031
VITE_WS_URL=ws://localhost:8031/ws

# Local AI (Ollama — install from https://ollama.ai)
VITE_OLLAMA_URL=http://localhost:11434

# Web3 / L.O.V.E. Ledger
VITE_WEB3_RPC=http://localhost:8545
VITE_LOVE_LEDGER_ADDRESS=

# Feature flags (all default to true)
# VITE_ENABLE_SERIAL=true
# VITE_ENABLE_WEB3=true
# VITE_ENABLE_OLLAMA=true
